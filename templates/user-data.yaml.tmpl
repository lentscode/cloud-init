#cloud-config
package_update: true
package_upgrade: false
timezone: Europe/Rome

users:
  - default
  - name: __ADMIN_USER__
    gecos: Personal administrator
    groups: [adm, sudo]
    shell: /bin/zsh
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_AUTHORIZED_KEY_YAML__

write_files:
  - path: /home/__ADMIN_USER__/.tmux.conf
    owner: __ADMIN_USER__:__ADMIN_USER__
    permissions: '0644'
    encoding: b64
    content: __TMUX_CONFIG_B64__
    defer: true
__OPTIONAL_WRITE_FILES__
  - path: /usr/local/lib/personal-bootstrap.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      admin_user="$1"
      admin_home="/home/$admin_user"

      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git pkg-config tmux unzip xz-utils zsh \
        golang-go sudo

      curl -fsSL https://deb.nodesource.com/setup_lts.x | bash -
      apt-get install -y --no-install-recommends nodejs

      case "$(dpkg --print-architecture)" in
        amd64) nvim_arch=x86_64 ;;
        arm64) nvim_arch=arm64 ;;
        *) echo "Unsupported Neovim architecture: $(dpkg --print-architecture)" >&2; exit 1 ;;
      esac
      nvim_tarball="/tmp/nvim-linux-${nvim_arch}.tar.gz"
      curl -fsSL "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${nvim_arch}.tar.gz" -o "$nvim_tarball"
      rm -rf "/opt/nvim-linux-${nvim_arch}"
      tar -C /opt -xzf "$nvim_tarball"
      ln -sfn "/opt/nvim-linux-${nvim_arch}/bin/nvim" /usr/local/bin/nvim
      rm -f "$nvim_tarball"

      install -d -o "$admin_user" -g "$admin_user" "$admin_home/.config"
      sudo -u "$admin_user" git clone https://github.com/lentscode/nvim-config "$admin_home/.config/nvim"

      sudo -u "$admin_user" -H bash -lc 'curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path'

      sudo -u "$admin_user" -H sh -c \
        'sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended'
      sed -i 's/^ZSH_THEME=.*/ZSH_THEME="agnoster"/' "$admin_home/.zshrc"
      printf '%s\n' \
        '# User-installed CLI tools.' \
        'export PNPM_HOME="$HOME/.local/share/pnpm"' \
        'export PATH="$HOME/.local/bin:$PNPM_HOME:$PATH"' \
        '[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"' \
        '# Start tmux for interactive SSH logins, but not shells inside tmux.' \
        'if [[ -n "$SSH_CONNECTION" && -z "$TMUX" ]]; then' \
        '  exec tmux' \
        'fi' \
        >> "$admin_home/.zshrc"
      chown "$admin_user:$admin_user" "$admin_home/.zshrc"

      # pnpm's standalone installer is the upstream-recommended Linux method.
      sudo -u "$admin_user" -H env SHELL=/bin/zsh bash -lc \
        'curl -fsSL https://get.pnpm.io/install.sh | sh -'

__OPTIONAL_BOOTSTRAP__

runcmd:
  - [bash, -lc, '/usr/local/lib/personal-bootstrap.sh __ADMIN_USER__']

final_message: 'Personal Ubuntu bootstrap completed after $UPTIME seconds.'
