#!/usr/bin/env bash

# Keep failures visible in any pipelines used by this script.
set -o pipefail

# Connect directly when given a session name or directory.
if (( $# )) && [[ "$1" != --picker-list ]]; then
  exec sesh connect "$1"
fi

# Ubuntu provides timeout through coreutils; Homebrew also names it gtimeout.
if ! SESH_PICKER_TIMEOUT=$(command -v timeout || command -v gtimeout); then
  echo 's: timeout or gtimeout is required; install coreutils.' >&2
  exit 127
fi

sesh_picker_list() {
  local status
  "$SESH_PICKER_TIMEOUT" 5s sesh list "$@"
  status=$?
  # Keep any rows already printed on timeout. Preserve every other failure.
  [[ "$status" -eq 124 ]] && return 0
  return "$status"
}

# Internal entry point for reloads. A tmux popup may inherit the server's
# environment, so exported functions from the calling shell are not reliable.
if [[ "${1:-}" == --picker-list ]]; then
  sesh_picker_list "${@:2}"
  exit "$?"
fi

# Embed an absolute, shell-quoted path in each reload command. Single quotes
# work in Bash, sh and Zsh, including paths containing spaces or apostrophes.
picker_script=$(command -v -- "$0")
[[ "$picker_script" == /* ]] || picker_script="$PWD/$picker_script"
single_quote="'"
escaped_quote="'\\''"
quoted_script=${picker_script//"$single_quote"/"$escaped_quote"}
list_command="'$quoted_script' --picker-list"

# Check listing failures separately: fzf uses 1 and 130 for cancellation, but
# those statuses from sesh must remain errors. Buffering also avoids SIGPIPE
# overriding a valid selection when fzf closes its input early under pipefail.
initial_list=$(sesh_picker_list --icons) || exit "$?"

# Capture the chosen row. Quoting "$selection" below preserves spaces in names.
# Inside tmux, -p opens a popup. Outside tmux, fzf-tmux runs regular fzf.
if selection=$(
  fzf-tmux -p 80%,70% \
    --no-sort --ansi --border-label ' sesh ' --prompt '⚡  ' \
    --header '  ^a all ^t tmux ^g configs ^x zoxide ^d exit ^f find' \
    --bind 'tab:down,btab:up' \
    --bind "ctrl-a:change-prompt(⚡  )+reload($list_command --icons)" \
    --bind "ctrl-t:change-prompt(🪟  )+reload($list_command -t --icons)" \
    --bind "ctrl-g:change-prompt(⚙️  )+reload($list_command -c --icons)" \
    --bind "ctrl-x:change-prompt(📁  )+reload($list_command -z --icons)" \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fdfind -H -d 2 -t d -E .Trash . ~)' \
    --bind 'ctrl-d:abort' \
    --preview-window 'right:55%' \
    --preview 'sesh preview {}' <<< "$initial_list"
); then
  # An empty selection should simply return to the calling shell.
  [[ -n "$selection" ]] || exit 0

  # Replace this script's process with sesh, which attaches or switches sessions.
  exec sesh connect "$selection"
else
  picker_status=$?

  # fzf returns 1 for no match and 130 for Escape or Ctrl+C.
  # Treat those as normal cancellation, but preserve other errors.
  case "$picker_status" in
    1|130) exit 0 ;;
    *) exit "$picker_status" ;;
  esac
fi
